Options -MultiViews
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Redirect www to the same host without www over HTTPS.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # Force HTTPS.
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Forward API requests to the local Node process when Apache proxy modules are enabled.
  <IfModule mod_proxy_http.c>
    RewriteRule ^api/?$ http://127.0.0.1:3001/api [P,L]
    RewriteRule ^api/(.*)$ http://127.0.0.1:3001/api/$1 [P,L]
  </IfModule>

  # The Polish portfolio is the default landing page.
  RewriteRule ^$ https://cimach.eu/pl/ [R=301,L]

  # Leave existing files and directories, including built assets, untouched.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Only the two published language routes are valid application pages.
  RewriteRule ^(?:pl|en)$ $0/ [R=301,L]
  RewriteRule ^(?!pl/|en/|404\.html$|robots\.txt$|sitemap\.xml$).+ - [R=404,L]
</IfModule>

ErrorDocument 404 /404.html

# Keep the portfolio photograph out of search engine image results.
<IfModule mod_headers.c>
  <FilesMatch "^main_photo.*\.(jpe?g|webp)$">
    Header set X-Robots-Tag "noindex, noimageindex"
  </FilesMatch>
</IfModule>

# Cache static assets while checking HTML for updates on each visit.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
</IfModule>

# Compress text responses and SVGs.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css
  AddOutputFilterByType DEFLATE application/javascript text/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>
